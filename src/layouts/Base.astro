---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Quechua Aventuras', description = 'Trekking y tours de aventura por Sudamérica' } = Astro.props;
const currentLocale = Astro.url.pathname.split('/')[1] || 'es';

const navLinks = {
  es: {
    home: '/es/',
    about: '/es/nosotros/',
    business: '/es/negocio/',
    tours: '/es/tours/',
    panel: '/es/panel/',
    contact: '/es/contacto/',
  },
  en: {
    home: '/en/',
    about: '/en/about/',
    business: '/en/business/',
    tours: '/en/tours/',
    panel: '/en/panel/',
    contact: '/en/contact/',
  },
};

const nav = navLinks[currentLocale as keyof typeof navLinks] || navLinks.es;
---

<!DOCTYPE html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⛰️</text></svg>" />
    <title>{title} | Quechua Aventuras</title>
  </head>
  <body>
    <nav class="navbar">
      <div class="nav-container">
        <a href={nav.home} class="logo">Quechua Aventuras</a>
        <input type="checkbox" id="nav-toggle" class="nav-toggle" />
        <label for="nav-toggle" class="nav-burger" aria-label="Menú">
          <span></span><span></span><span></span>
        </label>
        <ul class="nav-links">
          <li><a href={nav.home}>{currentLocale === 'es' ? 'Inicio' : 'Home'}</a></li>
          <li><a href={nav.about}>{currentLocale === 'es' ? 'Nosotros' : 'About'}</a></li>
          <li><a href={nav.business}>{currentLocale === 'es' ? 'Filosofía' : 'Business'}</a></li>
          <li><a href={nav.tours}>{currentLocale === 'es' ? 'Tours' : 'Tours'}</a></li>
          <li><a href={nav.panel}>{currentLocale === 'es' ? 'Panel' : 'Panel'}</a></li>
          <li><a href={nav.contact} class="nav-cta">{currentLocale === 'es' ? 'Contacto' : 'Contact'}</a></li>
        </ul>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-container">
        <p style="font-family: var(--font-display); font-size: 1.2rem; color: var(--gold-light); margin-bottom: 0.25rem;">⛰ Quechua Aventuras</p>
        <p style="font-size: 0.78rem; margin-bottom: 0.75rem;">(nombre provisional — pendiente de confirmar con Luis)</p>
        <p>Trekking y aventura auténtica por Sudamérica</p>
        <p>&copy; 2026 Quechua Aventuras. Todos los derechos reservados.</p>
      </div>
    </footer>
  </body>
</html>
