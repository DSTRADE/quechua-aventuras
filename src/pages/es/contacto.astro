---
import Base from '../../layouts/Base.astro';
---

<Base title="Contacto">
  <div class="hero" style="min-height: 34vh; background-image: url('https://images.unsplash.com/photo-1522199755839-a2bacb67c546?auto=format&fit=crop&w=1800&q=80');">
    <div class="hero-content">
      <span class="eyebrow">Contacto</span>
      <h1>Hablemos</h1>
      <p class="lede">Esta página sirve dos propósitos: aquí tus clientes te contactan para reservar, y aquí tú nos das información sobre el sitio.</p>
    </div>
  </div>

  <section>
    <div class="placeholder-note">
      📝 <strong>Importante, Luis:</strong> abajo hay dos formularios. El primero es <strong>para ti</strong> —
      dinos dónde quieres recibir los mensajes de tus clientes. El segundo es <strong>para tus clientes</strong>,
      quienes lo usarán para escribirte.
    </div>

    <div class="panel">
      <span class="eyebrow">Paso 1 · Para ti, Luis</span>
      <h2 class="mt-0">¿Dónde quieres recibir tus mensajes?</h2>
      <form id="setup-form">
        <label for="luis-email">Tu email principal</label>
        <input type="email" id="luis-email" name="luisEmail" required placeholder="Tu email donde recibirás mensajes" />

        <label for="luis-whatsapp">Tu WhatsApp (opcional)</label>
        <input type="tel" id="luis-whatsapp" name="luisWhatsapp" placeholder="Tu número de WhatsApp" />

        <label for="luis-phone">Tu teléfono (opcional)</label>
        <input type="tel" id="luis-phone" name="luisPhone" placeholder="Tu número de teléfono" />

        <label for="luis-location">Tu ubicación / ciudad base (opcional)</label>
        <input type="text" id="luis-location" name="luisLocation" placeholder="Ej: Cusco, Perú" />

        <label for="form-destination">¿Dónde quieres recibir los mensajes de los clientes?</label>
        <select id="form-destination" name="formDestination" required>
          <option value="">Selecciona una opción</option>
          <option value="email">Por email</option>
          <option value="whatsapp">Por WhatsApp</option>
          <option value="both">Ambos (email y WhatsApp)</option>
        </select>

        <label for="receiving-email">Email donde quieres recibir las consultas</label>
        <input type="email" id="receiving-email" name="receivingEmail" placeholder="Puede ser igual o diferente a tu email principal" />

        <button type="submit" id="setup-submit">Guardar mi información de contacto</button>
      </form>
      <div id="setup-status" style="margin-top: 1rem; font-weight: 600;"></div>
    </div>
  </section>

  <section>
    <span class="eyebrow">Paso 2 · Para tus clientes</span>
    <h2>Cómo te van a encontrar</h2>
    <p>Cuando completes el formulario de arriba, tus clientes potenciales usarán este formulario para escribirte.</p>

    <div class="card-grid" style="grid-template-columns: 1fr 1.2fr; align-items: start;">
      <div class="panel panel-cream">
        <h3 class="mt-0">Tu información actual</h3>
        <p><strong>📧 Email:</strong> <span id="display-email">—</span></p>
        <p><strong>📱 WhatsApp:</strong> <span id="display-whatsapp">—</span></p>
        <p><strong>📞 Teléfono:</strong> <span id="display-phone">—</span></p>
        <p><strong>📍 Ubicación:</strong> <span id="display-location">—</span></p>
      </div>

      <div class="panel">
        <h3 class="mt-0">Formulario de contacto para clientes</h3>
        <form id="customer-form">
          <label for="name">Nombre</label>
          <input type="text" id="name" name="name" required />

          <label for="email">Email</label>
          <input type="email" id="email" name="email" required />

          <label for="phone">Teléfono (opcional)</label>
          <input type="tel" id="phone" name="phone" />

          <label for="tour">¿Qué tour te interesa?</label>
          <select id="tour" name="tour" required>
            <option value="">Selecciona un tour</option>
            <option value="ausangate">Circuito Ausangate (Perú)</option>
            <option value="siete-lagunas">Siete Lagunas (Perú)</option>
            <option value="salkantay">Salkantay Trek (Perú)</option>
            <option value="personalizado">Tour personalizado</option>
          </select>

          <label for="message">Mensaje</label>
          <textarea id="message" name="message" required></textarea>

          <button type="submit" id="customer-submit">Enviar mensaje a Luis</button>
        </form>
      </div>
    </div>
  </section>

  <section>
    <h2>Horarios de disponibilidad</h2>
    <div class="editable-box" data-field="horarios">
      <div class="prompt-q">¿Cuáles son tus horarios y zona horaria? ¿Hay temporadas en que no operas?</div>
      <div class="prompt-hint">Ej: "Disponible de 7am a 8pm hora de Perú. No opero tours en enero y febrero por temporada de lluvias."</div>
      <textarea placeholder="Escribe tu respuesta aquí..."></textarea>
      <div class="save-row"><button class="btn-save">Guardar</button><span class="save-status"></span></div>
    </div>
  </section>
</Base>

<script>
  const API = 'https://quechua-aventuras.dstevo191.workers.dev';

  // ---- Setup form ----
  const setupForm = document.getElementById('setup-form') as HTMLFormElement;
  const setupStatus = document.getElementById('setup-status')!;
  const setupBtn = document.getElementById('setup-submit') as HTMLButtonElement;

  setupForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    setupBtn.disabled = true;
    const formData = new FormData(setupForm);
    try {
      const res = await fetch(`${API}/api/setup-contact`, { method: 'POST', body: formData });
      const result = await res.json();
      if (result.success) {
        document.getElementById('display-email')!.textContent = (formData.get('luisEmail') as string) || '—';
        document.getElementById('display-whatsapp')!.textContent = (formData.get('luisWhatsapp') as string) || '—';
        document.getElementById('display-phone')!.textContent = (formData.get('luisPhone') as string) || '—';
        document.getElementById('display-location')!.textContent = (formData.get('luisLocation') as string) || '—';
        setupStatus.style.color = 'var(--forest)';
        setupStatus.textContent = '✓ Tu información de contacto ha sido guardada.';
        setupForm.reset();
      } else {
        setupStatus.style.color = 'var(--clay)';
        setupStatus.textContent = 'Error: ' + result.message;
      }
    } catch (err) {
      setupStatus.style.color = 'var(--clay)';
      setupStatus.textContent = 'Error al guardar tu información';
    } finally {
      setupBtn.disabled = false;
    }
  });

  // ---- Customer form ----
  const customerForm = document.getElementById('customer-form') as HTMLFormElement;
  const customerBtn = document.getElementById('customer-submit') as HTMLButtonElement;

  customerForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    customerBtn.disabled = true;
    const originalText = customerBtn.textContent;
    customerBtn.textContent = 'Enviando...';
    const formData = new FormData(customerForm);
    try {
      const res = await fetch(`${API}/api/contact`, { method: 'POST', body: formData });
      const result = await res.json();
      if (result.success) {
        alert('✓ Mensaje enviado. Luis te contactará pronto.');
        customerForm.reset();
      } else {
        alert('Error: ' + result.message);
      }
    } catch (err) {
      alert('Error al enviar el mensaje');
    } finally {
      customerBtn.disabled = false;
      customerBtn.textContent = originalText;
    }
  });

  // ---- Editable box (horarios) ----
  const PAGE = 'contacto';
  async function loadContent() {
    try {
      const res = await fetch(`${API}/api/get-content?page=${PAGE}`);
      const result = await res.json();
      if (result.success) {
        document.querySelectorAll('.editable-box').forEach((box) => {
          const field = box.getAttribute('data-field');
          const textarea = box.querySelector('textarea') as HTMLTextAreaElement;
          if (field && result.data[field]) textarea.value = result.data[field];
        });
      }
    } catch (e) {
      console.error(e);
    }
  }

  document.querySelectorAll('.editable-box').forEach((box) => {
    const field = box.getAttribute('data-field');
    const textarea = box.querySelector('textarea') as HTMLTextAreaElement;
    const btn = box.querySelector('.btn-save') as HTMLButtonElement;
    const status = box.querySelector('.save-status') as HTMLElement;
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      status.textContent = 'Guardando...';
      try {
        const res = await fetch(`${API}/api/save-content`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ page: PAGE, field, value: textarea.value }),
        });
        const result = await res.json();
        status.textContent = result.success ? '✓ Guardado' : 'Error al guardar';
        setTimeout(() => (status.textContent = ''), 3000);
      } catch {
        status.textContent = 'Error al guardar';
      } finally {
        btn.disabled = false;
      }
    });
  });

  loadContent();
</script>
