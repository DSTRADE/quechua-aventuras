---
import Base from '../../layouts/Base.astro';
---

<Base title="Bienvenida a Tu Sitio Web">
  <div class="hero" style="background-image: url('https://images.unsplash.com/photo-1531065208531-4036c0dba3ca?auto=format&fit=crop&w=1800&q=80');">
    <div class="hero-content">
      <span class="eyebrow">Sitio de demostración para Luis</span>
      <h1>¡Hola Luis! Bienvenido a Quechua Aventuras</h1>
      <p style="color: var(--gold-light); font-size: 0.9rem; margin-bottom: 1rem;">
        (nombre provisional — "Quechua Aventuras" es solo un ejemplo, lo cambiamos cuando decidas el nombre real)
      </p>
      <p class="lede">
        Este es un adelanto de tu futuro sitio web: trekking y aventura auténtica a través de todo Sudamérica —
        Perú, Bolivia, Chile, Argentina y más. Construido para atraer clientes de todo el mundo.
      </p>
      <div class="hero-actions">
        <a href="#como-funciona" class="btn btn-gold">¿Cómo funciona esto?</a>
        <a href="/es/tours/" class="btn btn-ghost">Ver el catálogo de tours</a>
      </div>
    </div>
  </div>

  <section id="como-funciona">
    <div class="section-head">
      <span class="eyebrow">Para ti, Luis</span>
      <h2>¿Qué es esto exactamente?</h2>
    </div>
    <p>
      Este es tu sitio web personal para promocionar tus tours de aventura por Sudamérica. Aquí es donde
      los clientes potenciales del mundo entero van a conocerte, ver tus tours y contactarte para reservar.
    </p>
    <p>
      <strong>Lo importante:</strong> no necesitas saber nada de tecnología. Tú compartes tu historia, tus tours
      y tus fotos — de la forma que te resulte más cómoda — y nosotros construimos y mantenemos todo lo demás.
    </p>

    <div class="card-grid">
      <div class="card feature-card">
        <div class="feature-icon">📝</div>
        <div class="card-content">
          <h3 class="card-title">Tú compartes, nosotros escribimos</h3>
          <p class="card-text">
            Nos das la información en bruto — datos, ideas sueltas, un par de frases — y la convertimos en
            texto profesional y atractivo para tu sitio.
          </p>
        </div>
      </div>

      <div class="card feature-card">
        <div class="feature-icon">🎙️</div>
        <div class="card-content">
          <h3 class="card-title">Escrito o por voz — como prefieras</h3>
          <p class="card-text">
            Puedes escribir directamente en los cuadros de este sitio, o simplemente grabar una nota de voz
            y enviarla — nosotros la transcribimos y la incorporamos por ti.
          </p>
        </div>
      </div>

      <div class="card feature-card">
        <div class="feature-icon">🤖</div>
        <div class="card-content">
          <h3 class="card-title">Ayuda automática con tus tours</h3>
          <p class="card-text">
            Para cada tour solo necesitamos el nombre, el país y el precio. Nosotros investigamos y
            completamos automáticamente la descripción, distancia, elevación, dificultad e itinerario —
            tú simplemente revisas y corriges lo que haga falta.
          </p>
        </div>
      </div>

      <div class="card feature-card">
        <div class="feature-icon">🌎</div>
        <div class="card-content">
          <h3 class="card-title">Múltiples países, múltiples idiomas</h3>
          <p class="card-text">
            El sitio está organizado por país (Perú, Bolivia, Chile, Argentina...) y listo para traducirse a
            inglés, francés y polaco en cuanto estés conforme con el contenido en español.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="explainer-banner">
      <h3>💬 Cómo darnos tu información</h3>
      <p>En cada página vas a encontrar cuadros de texto editables, marcados con un borde dorado punteado. Ahí puedes escribir tu respuesta directamente y presionar "Guardar" — queda almacenada en el sitio y puedes volver a editarla cuando quieras.</p>
      <p>¿Prefieres hablar en vez de escribir? Perfecto — graba una nota de voz (por WhatsApp o donde te resulte más fácil) y envíamela. Yo la transcribo y la agrego al sitio por ti.</p>
      <p>Para los tours, es aún más simple: dame el nombre del tour, el país y el precio — el sitio busca y sugiere automáticamente el resto de los detalles para que tú solo tengas que revisarlos.</p>
    </div>
  </section>

  <section>
    <div class="section-head">
      <span class="eyebrow">Explora el sitio</span>
      <h2>¿Qué vas a encontrar?</h2>
    </div>
    <div class="card-grid">
      <a href="/es/nosotros/" style="text-decoration:none;color:inherit;">
        <div class="card">
          <div class="card-content">
            <h3 class="card-title">Nosotros</h3>
            <p class="card-text">Tu biografía, experiencia y lo que te hace único como guía.</p>
          </div>
        </div>
      </a>
      <a href="/es/negocio/" style="text-decoration:none;color:inherit;">
        <div class="card">
          <div class="card-content">
            <h3 class="card-title">Filosofía</h3>
            <p class="card-text">Tus valores, principios y respuestas a las preguntas más frecuentes.</p>
          </div>
        </div>
      </a>
      <a href="/es/tours/" style="text-decoration:none;color:inherit;">
        <div class="card">
          <div class="card-content">
            <h3 class="card-title">Tours</h3>
            <p class="card-text">Tu catálogo completo, organizado por país, con todos los detalles.</p>
          </div>
        </div>
      </a>
      <a href="/es/contacto/" style="text-decoration:none;color:inherit;">
        <div class="card">
          <div class="card-content">
            <h3 class="card-title">Contacto</h3>
            <p class="card-text">Cómo tus clientes te van a encontrar y reservar contigo.</p>
          </div>
        </div>
      </a>
      <a href="/es/panel/" style="text-decoration:none;color:inherit;">
        <div class="card" style="border-color: var(--gold);">
          <div class="card-content">
            <h3 class="card-title">🎛️ Panel de Control</h3>
            <p class="card-text">Estado del sitio y el lugar para pedir todos tus cambios.</p>
            <span class="pill pill-gold">Solo para ti</span>
          </div>
        </div>
      </a>
    </div>
  </section>

  <section>
    <div class="explainer-banner">
      <h3>🧭 Una página distinta de todas las demás</h3>
      <p>
        Inicio, Nosotros, Filosofía, Tours y Contacto son las páginas que van a ver tus <strong>clientes</strong>.
        A medida que nos mandes tus textos y fotos, las iremos afinando hasta que suenen 100% a ti y estén
        listas para el público — el contenido de ejemplo que ves ahora es solo un punto de partida.
      </p>
      <p>
        El <strong>Panel de Control</strong> es la única página que es solo para ti. Nunca la verán tus clientes.
        Ahí puedes revisar de un vistazo qué falta completar en el sitio, y pedir cualquier cambio — de diseño,
        de una página entera, o de un tour específico — durante todo el proceso, incluso después de que el
        sitio esté publicado.
      </p>
    </div>
  </section>

  <section>
    <div class="section-head">
      <span class="eyebrow">Tus fotos</span>
      <h2>Sube tus fotos</h2>
    </div>
    <p>Las fotos son de lo más importante del sitio — ayudan a que los clientes confíen en ti antes de conocerte. Sube lo que tengas a mano ahora; siempre puedes agregar más adelante.</p>

    <h3>Fotos tuyas en tus aventuras</h3>
    <div class="photo-upload" data-photo-page="home-luis">
      <div class="prompt-hint">Fotos tuyas guiando, en la montaña, con clientes — lo que muestre quién eres como guía.</div>
      <div class="photo-upload-controls">
        <input type="file" class="photo-file-input" accept="image/*" multiple />
        <input type="text" class="photo-caption-input" placeholder="Descripción breve (opcional)" />
        <button type="button" class="btn-upload">Subir foto(s)</button>
      </div>
      <div class="photo-status" style="margin-bottom:0.75rem;font-weight:600;"></div>
      <div class="photo-grid"><p class="photo-empty">Cargando...</p></div>
    </div>

    <h3>Tus fotos favoritas para el sitio</h3>
    <div class="photo-upload" data-photo-page="home-favorites">
      <div class="prompt-hint">Paisajes, rutas, momentos con clientes — cualquier foto que te encantaría ver en el sitio, aunque no salgas tú.</div>
      <div class="photo-upload-controls">
        <input type="file" class="photo-file-input" accept="image/*" multiple />
        <input type="text" class="photo-caption-input" placeholder="Descripción breve (opcional)" />
        <button type="button" class="btn-upload">Subir foto(s)</button>
      </div>
      <div class="photo-status" style="margin-bottom:0.75rem;font-weight:600;"></div>
      <div class="photo-grid"><p class="photo-empty">Cargando...</p></div>
    </div>
  </section>

  <section>
    <div class="section-head">
      <span class="eyebrow">Importante</span>
      <h2>¿Algo no encaja con tu negocio?</h2>
    </div>
    <p>
      Hicimos varias suposiciones para armar esta demo — por ejemplo, que tú mismo guías todos los tours.
      Si tu negocio funciona distinto (por ejemplo, si también ofreces tours guiados por otras personas que
      tú contratas, o cualquier otra cosa que hayamos entendido mal), este es el lugar para aclararlo.
      Úsalo para cualquier corrección estructural, no solo de contenido.
    </p>
    <div class="editable-box" data-field="general" style="border-color: var(--clay);">
      <div class="prompt-q">Cuéntanos qué deberíamos cambiar, corregir o tener en cuenta</div>
      <div class="prompt-hint">Ej: "También trabajo con otros dos guías que llevan algunos de mis tours" o "No ofrezco tours en Bolivia todavía."</div>
      <textarea placeholder="Escribe aquí cualquier corrección o aclaración sobre cómo funciona tu negocio..."></textarea>
      <div class="save-row"><button class="btn-save">Guardar</button><span class="save-status"></span></div>
    </div>
  </section>

  <section class="text-center">
    <div class="panel panel-cream">
      <h3>Siguiente paso</h3>
      <p>Recorre el sitio, revisa cada sección y empieza a completar la información cuando quieras.</p>
      <a href="/es/contacto/" class="btn btn-primary">Ir a Contacto</a>
    </div>
  </section>
</Base>

<script>
  const API = 'https://quechua-aventuras.dstevo191.workers.dev';
  const PAGE = 'sitio';

  async function loadGeneral() {
    try {
      const res = await fetch(`${API}/api/get-content?page=${PAGE}`);
      const result = await res.json();
      if (result.success) {
        document.querySelectorAll('.editable-box').forEach((box) => {
          const field = box.getAttribute('data-field');
          const textarea = box.querySelector('textarea') as HTMLTextAreaElement;
          if (field && result.data[field]) textarea.value = result.data[field];
        });
      }
    } catch (e) {
      console.error(e);
    }
  }

  function wireSave() {
    document.querySelectorAll('.editable-box').forEach((box) => {
      const field = box.getAttribute('data-field');
      const textarea = box.querySelector('textarea') as HTMLTextAreaElement;
      const btn = box.querySelector('.btn-save') as HTMLButtonElement;
      const status = box.querySelector('.save-status') as HTMLElement;
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        status.textContent = 'Guardando...';
        try {
          const res = await fetch(`${API}/api/save-content`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ page: PAGE, field, value: textarea.value }),
          });
          const result = await res.json();
          status.textContent = result.success ? '✓ Guardado' : 'Error al guardar';
          setTimeout(() => (status.textContent = ''), 3000);
        } catch {
          status.textContent = 'Error al guardar';
        } finally {
          btn.disabled = false;
        }
      });
    });
  }

  loadGeneral();
  wireSave();

  // ---- Photo upload widgets ----
  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  }

  function initPhotoUpload(container: HTMLElement) {
    const page = container.getAttribute('data-photo-page')!;
    const fileInput = container.querySelector('.photo-file-input') as HTMLInputElement;
    const captionInput = container.querySelector('.photo-caption-input') as HTMLInputElement;
    const uploadBtn = container.querySelector('.btn-upload') as HTMLButtonElement;
    const status = container.querySelector('.photo-status') as HTMLElement;
    const grid = container.querySelector('.photo-grid') as HTMLElement;

    async function loadPhotos() {
      try {
        const res = await fetch(`${API}/api/photos?page=${page}`);
        const result = await res.json();
        if (result.success && result.photos.length) {
          grid.innerHTML = result.photos.map((p: any) => `
            <div class="photo-thumb" data-id="${p.id}">
              <img src="${p.dataUrl}" alt="${escapeHtml(p.caption || '')}" />
              ${p.caption ? `<div class="photo-caption">${escapeHtml(p.caption)}</div>` : ''}
              <button type="button" class="photo-remove" data-id="${p.id}" aria-label="Eliminar">×</button>
            </div>`).join('');
          grid.querySelectorAll('.photo-remove').forEach((btn) => {
            btn.addEventListener('click', async () => {
              const id = btn.getAttribute('data-id')!;
              await fetch(`${API}/api/delete-photo`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ page, id }),
              });
              loadPhotos();
            });
          });
        } else {
          grid.innerHTML = '<p class="photo-empty">Todavía no hay fotos aquí.</p>';
        }
      } catch {
        grid.innerHTML = '<p class="photo-empty">No se pudieron cargar las fotos.</p>';
      }
    }

    uploadBtn.addEventListener('click', async () => {
      const files = fileInput.files;
      if (!files || files.length === 0) {
        status.style.color = 'var(--clay)';
        status.textContent = 'Elige al menos una foto primero.';
        return;
      }
      uploadBtn.disabled = true;
      status.style.color = 'var(--forest)';
      status.textContent = 'Subiendo...';
      let okCount = 0;
      for (const file of Array.from(files)) {
        const fd = new FormData();
        fd.append('page', page);
        fd.append('caption', captionInput.value || '');
        fd.append('file', file);
        try {
          const res = await fetch(`${API}/api/upload-photo`, { method: 'POST', body: fd });
          const result = await res.json();
          if (result.success) okCount++;
        } catch {
          // continue with remaining files
        }
      }
      status.textContent = okCount === files.length ? `✓ ${okCount} foto(s) subida(s)` : `Se subieron ${okCount} de ${files.length} foto(s)`;
      fileInput.value = '';
      captionInput.value = '';
      uploadBtn.disabled = false;
      loadPhotos();
      setTimeout(() => (status.textContent = ''), 4000);
    });

    loadPhotos();
  }

  document.querySelectorAll('.photo-upload').forEach((el) => initPhotoUpload(el as HTMLElement));
</script>
