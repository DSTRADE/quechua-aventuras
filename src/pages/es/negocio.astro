---
import Base from '../../layouts/Base.astro';
---

<Base title="Tu Negocio y Filosofía">
  <div class="hero" style="min-height: 40vh; background-image: url('https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&w=1800&q=80');">
    <div class="hero-content">
      <span class="eyebrow">Tu filosofía</span>
      <h1>Por qué haces lo que haces</h1>
      <p class="lede">No es solo sobre trekking técnico — es sobre tu visión como guía y negocio.</p>
    </div>
  </div>

  <section>
    <div class="placeholder-note">
      💡 Los turistas modernos no solo buscan una caminata — buscan un guía con valores claros. Esta página
      genera confianza antes de que el cliente siquiera te escriba.
    </div>

    <h2>Tu filosofía, en tus palabras</h2>

    <div class="editable-box" data-field="fil_grupos">
      <div class="prompt-q">¿Cuál es tu filosofía sobre el tamaño de los grupos?</div>
      <div class="prompt-hint">¿Prefieres grupos pequeños o grandes? ¿Cuál es tu límite por tour?</div>
      <textarea placeholder="Escribe tu respuesta aquí..."></textarea>
      <div class="save-row"><button class="btn-save">Guardar</button><span class="save-status"></span></div>
    </div>

    <div class="editable-box" data-field="fil_seguridad">
      <div class="prompt-q">¿Cómo aseguras la seguridad de tus clientes?</div>
      <textarea placeholder="Escribe tu respuesta aquí..."></textarea>
      <div class="save-row"><button class="btn-save">Guardar</button><span class="save-status"></span></div>
    </div>

    <div class="editable-box" data-field="fil_comunidad">
      <div class="prompt-q">¿Cuál es tu conexión con las comunidades locales de las zonas donde operas?</div>
      <textarea placeholder="Escribe tu respuesta aquí..."></textarea>
      <div class="save-row"><button class="btn-save">Guardar</button><span class="save-status"></span></div>
    </div>

    <div class="editable-box" data-field="fil_ambiente">
      <div class="prompt-q">¿Cómo cuidas el medio ambiente en tus tours?</div>
      <textarea placeholder="Escribe tu respuesta aquí..."></textarea>
      <div class="save-row"><button class="btn-save">Guardar</button><span class="save-status"></span></div>
    </div>

    <div class="editable-box" data-field="fil_diferente">
      <div class="prompt-q">¿Qué hace tu enfoque diferente al de otros guías u operadores?</div>
      <textarea placeholder="Escribe tu respuesta aquí..."></textarea>
      <div class="save-row"><button class="btn-save">Guardar</button><span class="save-status"></span></div>
    </div>

    <h2>Preguntas frecuentes</h2>
    <p>Los clientes siempre preguntan lo mismo — respondamos aquí de forma clara.</p>

    <div class="editable-box" data-field="faq_fitness">
      <div class="prompt-q">¿Qué nivel de fitness se requiere para tus tours?</div>
      <textarea placeholder="Escribe tu respuesta aquí..."></textarea>
      <div class="save-row"><button class="btn-save">Guardar</button><span class="save-status"></span></div>
    </div>

    <div class="editable-box" data-field="faq_incluido">
      <div class="prompt-q">¿Qué está incluido normalmente en el precio, y qué no?</div>
      <textarea placeholder="Escribe tu respuesta aquí..."></textarea>
      <div class="save-row"><button class="btn-save">Guardar</button><span class="save-status"></span></div>
    </div>

    <div class="editable-box" data-field="faq_soroche">
      <div class="prompt-q">¿Qué pasa si un cliente se enferma por la altura (soroche) durante el tour?</div>
      <textarea placeholder="Escribe tu respuesta aquí..."></textarea>
      <div class="save-row"><button class="btn-save">Guardar</button><span class="save-status"></span></div>
    </div>

    <div class="editable-box" data-field="faq_otros_guias">
      <div class="prompt-q">¿Todos los tours los guías tú personalmente, o trabajas con otros guías también?</div>
      <div class="prompt-hint">Esto nos ayuda a mostrar correctamente quién lidera cada tour en el sitio.</div>
      <textarea placeholder="Escribe tu respuesta aquí..."></textarea>
      <div class="save-row"><button class="btn-save">Guardar</button><span class="save-status"></span></div>
    </div>

    <div class="placeholder-note">
      📝 <strong>Tu turno:</strong> Responde lo que puedas ahora, guarda, y vuelve cuando quieras a completar el resto.
    </div>

    <h2>¿Algo más?</h2>
    <div class="editable-box" data-field="otros" style="border-color: var(--clay);">
      <div class="prompt-q">Cosas importantes sobre tu negocio que no te preguntamos</div>
      <div class="prompt-hint">Cualquier cosa que creas que debería estar en esta página y no cubrimos arriba.</div>
      <textarea placeholder="Escribe aquí..."></textarea>
      <div class="save-row"><button class="btn-save">Guardar</button><span class="save-status"></span></div>
    </div>
  </section>

  <section>
    <div class="card-grid">
      <img src="https://images.unsplash.com/photo-1517824806704-9040b037703b?auto=format&fit=crop&w=500&q=80" alt="Guía con grupo" style="width:100%;height:230px;object-fit:cover;border-radius:var(--radius-md);" />
      <img src="https://images.unsplash.com/photo-1454496522488-7a8e488e8606?auto=format&fit=crop&w=500&q=80" alt="Lago de montaña" style="width:100%;height:230px;object-fit:cover;border-radius:var(--radius-md);" />
      <img src="https://images.unsplash.com/photo-1444065381814-865dc9da92c0?auto=format&fit=crop&w=500&q=80" alt="Sendero" style="width:100%;height:230px;object-fit:cover;border-radius:var(--radius-md);" />
    </div>
  </section>
</Base>

<script>
  const PAGE = 'negocio';
  const API = 'https://quechua-aventuras.dstevo191.workers.dev';

  async function loadContent() {
    try {
      const res = await fetch(`${API}/api/get-content?page=${PAGE}`);
      const result = await res.json();
      if (result.success) {
        document.querySelectorAll('.editable-box').forEach((box) => {
          const field = box.getAttribute('data-field');
          const textarea = box.querySelector('textarea') as HTMLTextAreaElement;
          if (field && result.data[field]) textarea.value = result.data[field];
        });
      }
    } catch (e) {
      console.error('Failed to load content', e);
    }
  }

  function wireSaveButtons() {
    document.querySelectorAll('.editable-box').forEach((box) => {
      const field = box.getAttribute('data-field');
      const textarea = box.querySelector('textarea') as HTMLTextAreaElement;
      const btn = box.querySelector('.btn-save') as HTMLButtonElement;
      const status = box.querySelector('.save-status') as HTMLElement;

      btn.addEventListener('click', async () => {
        btn.disabled = true;
        status.textContent = 'Guardando...';
        try {
          const res = await fetch(`${API}/api/save-content`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ page: PAGE, field, value: textarea.value }),
          });
          const result = await res.json();
          status.textContent = result.success ? '✓ Guardado' : 'Error al guardar';
          setTimeout(() => (status.textContent = ''), 3000);
        } catch {
          status.textContent = 'Error al guardar';
        } finally {
          btn.disabled = false;
        }
      });
    });
  }

  loadContent();
  wireSaveButtons();
</script>
