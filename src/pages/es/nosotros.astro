---
import Base from '../../layouts/Base.astro';
---

<Base title="Sobre Luis">
  <div class="hero" style="min-height: 42vh; background-image: url('https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1800&q=80');">
    <div class="hero-content">
      <span class="eyebrow">Sobre ti, Luis</span>
      <h1>La cara detrás de Quechua Aventuras</h1>
      <p class="lede">Esta página es donde los clientes deciden si confían en ti. Cuéntales quién eres.</p>
    </div>
  </div>

  <section>
    <div class="placeholder-note">
      💡 <strong>Consejo:</strong> Esta página debe sonar como tú. Imagina que le estás contando tu historia a
      un viajero frente a un café en Cusco — así de natural debería sentirse.
    </div>

    <div class="panel text-center" style="margin-bottom: 2.5rem;">
      <img
        src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?auto=format&fit=crop&w=500&q=80"
        alt="Foto de Luis"
        style="width: 220px; height: 220px; border-radius: 50%; object-fit: cover; margin-bottom: 1rem; box-shadow: var(--shadow-md);"
      />
      <p style="color: var(--stone); font-size: 0.9rem;">📸 Aquí va tu foto — envíanos una que te guste, idealmente en las montañas.</p>
    </div>

    <h2>Tu historia</h2>
    <p>Responde estas preguntas con tus propias palabras — escribe directamente abajo, o mándanos una nota de voz y nosotros la pasamos a texto.</p>

    <div class="editable-box" data-field="bio_inicio">
      <div class="prompt-q">¿Cuánto tiempo llevas como guía de montaña y cómo empezaste?</div>
      <div class="prompt-hint">Ej: "Comencé en 1995 cuando tenía 20 años. Desde entonces he hecho más de 500 tours..."</div>
      <textarea placeholder="Escribe tu respuesta aquí..."></textarea>
      <div class="save-row"><button class="btn-save">Guardar</button><span class="save-status"></span></div>
    </div>

    <div class="editable-box" data-field="bio_regiones">
      <div class="prompt-q">¿En qué regiones y países has trabajado?</div>
      <div class="prompt-hint">Ej: "He guiado en Cusco, el Altiplano boliviano y la Patagonia chilena..."</div>
      <textarea placeholder="Escribe tu respuesta aquí..."></textarea>
      <div class="save-row"><button class="btn-save">Guardar</button><span class="save-status"></span></div>
    </div>

    <div class="editable-box" data-field="bio_memorable">
      <div class="prompt-q">¿Cuál ha sido tu experiencia más memorable como guía?</div>
      <div class="prompt-hint">Ej: "Una vez guié a una abuela de 75 años al Ausangate y fue la mejor experiencia de su vida..."</div>
      <textarea placeholder="Escribe tu respuesta aquí..."></textarea>
      <div class="save-row"><button class="btn-save">Guardar</button><span class="save-status"></span></div>
    </div>

    <div class="editable-box" data-field="bio_pasion">
      <div class="prompt-q">¿Qué te apasiona de las montañas de Sudamérica?</div>
      <textarea placeholder="Escribe tu respuesta aquí..."></textarea>
      <div class="save-row"><button class="btn-save">Guardar</button><span class="save-status"></span></div>
    </div>

    <div class="editable-box" data-field="bio_porque">
      <div class="prompt-q">¿Por qué decidiste crear Quechua Aventuras por tu cuenta?</div>
      <textarea placeholder="Escribe tu respuesta aquí..."></textarea>
      <div class="save-row"><button class="btn-save">Guardar</button><span class="save-status"></span></div>
    </div>

    <h2>Tu experiencia y credibilidad</h2>
    <p>Ayuda a los turistas a confiar en ti como profesional.</p>

    <div class="editable-box" data-field="exp_anos">
      <div class="prompt-q">¿Cuántos años de experiencia tienes y cuántos tours has completado aproximadamente?</div>
      <textarea placeholder="Escribe tu respuesta aquí..."></textarea>
      <div class="save-row"><button class="btn-save">Guardar</button><span class="save-status"></span></div>
    </div>

    <div class="editable-box" data-field="exp_certificaciones">
      <div class="prompt-q">¿Tienes certificaciones? (primeros auxilios, rescate de altura, guía oficial, etc.)</div>
      <textarea placeholder="Escribe tu respuesta aquí..."></textarea>
      <div class="save-row"><button class="btn-save">Guardar</button><span class="save-status"></span></div>
    </div>

    <div class="editable-box" data-field="exp_idiomas">
      <div class="prompt-q">¿Qué idiomas hablas?</div>
      <textarea placeholder="Escribe tu respuesta aquí..."></textarea>
      <div class="save-row"><button class="btn-save">Guardar</button><span class="save-status"></span></div>
    </div>

    <div class="editable-box" data-field="exp_especialidad">
      <div class="prompt-q">¿Tienes alguna especialidad? (alta altitud, trekking técnico, arqueología, fotografía...)</div>
      <textarea placeholder="Escribe tu respuesta aquí..."></textarea>
      <div class="save-row"><button class="btn-save">Guardar</button><span class="save-status"></span></div>
    </div>

    <div class="placeholder-note">
      📝 <strong>Tu turno:</strong> Completa lo que puedas ahora — puedes volver más tarde y seguir editando.
      Todo lo que escribas queda guardado automáticamente en el sitio.
    </div>

    <h2>¿Algo más?</h2>
    <div class="editable-box" data-field="otros" style="border-color: var(--clay);">
      <div class="prompt-q">Cosas importantes sobre ti que no te preguntamos</div>
      <div class="prompt-hint">Cualquier cosa que creas que debería estar en esta página y no cubrimos arriba.</div>
      <textarea placeholder="Escribe aquí..."></textarea>
      <div class="save-row"><button class="btn-save">Guardar</button><span class="save-status"></span></div>
    </div>
  </section>

  <section>
    <div class="section-head">
      <span class="eyebrow">Prueba social</span>
      <h2>Testimonios de tus clientes</h2>
    </div>
    <p>Nada genera más confianza que las palabras de clientes anteriores. Si tienes reseñas de Google, TripAdvisor, WhatsApp o donde sea, pásanoslas aquí — con el nombre de la persona y, si quieres, qué tour hizo.</p>

    <form id="testimonial-form">
      <label for="t-name">Nombre del cliente</label>
      <input type="text" id="t-name" name="authorName" required placeholder="Ej: Sarah Thompson" />

      <label for="t-origin">País de origen (opcional)</label>
      <input type="text" id="t-origin" name="authorOrigin" placeholder="Ej: Reino Unido" />

      <label for="t-tour">Tour que hizo (opcional)</label>
      <input type="text" id="t-tour" name="tourName" placeholder="Ej: Salkantay Trek" />

      <label for="t-text">Testimonio</label>
      <textarea id="t-text" name="text" required placeholder="Copia o escribe aquí lo que dijo el cliente..."></textarea>

      <button type="submit" id="testimonial-submit-btn">Agregar testimonio</button>
    </form>
    <div id="testimonial-status" style="margin-top: 1rem; font-weight: 600;"></div>

    <div id="testimonial-list" class="card-grid" style="margin-top: 2rem;">
      <p class="photo-empty">Cargando...</p>
    </div>
  </section>
</Base>

<script>
  const PAGE = 'nosotros';
  const API = 'https://quechua-aventuras.dstevo191.workers.dev';

  async function loadContent() {
    try {
      const res = await fetch(`${API}/api/get-content?page=${PAGE}`);
      const result = await res.json();
      if (result.success) {
        document.querySelectorAll('.editable-box').forEach((box) => {
          const field = box.getAttribute('data-field');
          const textarea = box.querySelector('textarea') as HTMLTextAreaElement;
          if (field && result.data[field]) {
            textarea.value = result.data[field];
          }
        });
      }
    } catch (e) {
      console.error('Failed to load content', e);
    }
  }

  function wireSaveButtons() {
    document.querySelectorAll('.editable-box').forEach((box) => {
      const field = box.getAttribute('data-field');
      const textarea = box.querySelector('textarea') as HTMLTextAreaElement;
      const btn = box.querySelector('.btn-save') as HTMLButtonElement;
      const status = box.querySelector('.save-status') as HTMLElement;

      btn.addEventListener('click', async () => {
        btn.disabled = true;
        status.textContent = 'Guardando...';
        status.classList.add('saving');
        try {
          const res = await fetch(`${API}/api/save-content`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ page: PAGE, field, value: textarea.value }),
          });
          const result = await res.json();
          status.classList.remove('saving');
          status.textContent = result.success ? '✓ Guardado' : 'Error al guardar';
          setTimeout(() => (status.textContent = ''), 3000);
        } catch (e) {
          status.classList.remove('saving');
          status.textContent = 'Error al guardar';
        } finally {
          btn.disabled = false;
        }
      });
    });
  }

  loadContent();
  wireSaveButtons();

  // ---- Testimonials ----
  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  }

  function testimonialCard(t: any): string {
    return `
      <div class="card">
        <div class="card-content">
          <p class="card-text" style="font-style: italic;">"${escapeHtml(t.text)}"</p>
          <div class="card-meta">
            <strong style="color: var(--forest);">${escapeHtml(t.authorName)}</strong>
            ${t.authorOrigin ? `<span class="pill">${escapeHtml(t.authorOrigin)}</span>` : ''}
            ${t.tourName ? `<span class="pill pill-clay">${escapeHtml(t.tourName)}</span>` : ''}
          </div>
          <button type="button" class="testimonial-remove" data-id="${t.id}" style="margin-top:0.75rem;background:none;border:none;color:var(--stone);font-size:0.8rem;cursor:pointer;text-decoration:underline;">Eliminar</button>
        </div>
      </div>`;
  }

  async function loadTestimonials() {
    const list = document.getElementById('testimonial-list')!;
    try {
      const res = await fetch(`${API}/api/testimonials`);
      const result = await res.json();
      if (result.success && result.testimonials.length) {
        list.innerHTML = result.testimonials.map(testimonialCard).join('');
        list.querySelectorAll('.testimonial-remove').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-id')!;
            await fetch(`${API}/api/delete-testimonial`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id }),
            });
            loadTestimonials();
          });
        });
      } else {
        list.innerHTML = '<p class="photo-empty">Todavía no agregaste testimonios.</p>';
      }
    } catch {
      list.innerHTML = '<p class="photo-empty">No se pudieron cargar los testimonios.</p>';
    }
  }

  const testimonialForm = document.getElementById('testimonial-form') as HTMLFormElement;
  const testimonialStatus = document.getElementById('testimonial-status')!;
  const testimonialBtn = document.getElementById('testimonial-submit-btn') as HTMLButtonElement;

  testimonialForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    testimonialBtn.disabled = true;
    testimonialStatus.textContent = '';
    try {
      const fd = new FormData(testimonialForm);
      const res = await fetch(`${API}/api/testimonials`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          authorName: fd.get('authorName'),
          authorOrigin: fd.get('authorOrigin'),
          tourName: fd.get('tourName'),
          text: fd.get('text'),
        }),
      });
      const result = await res.json();
      if (result.success) {
        testimonialStatus.style.color = 'var(--forest)';
        testimonialStatus.textContent = '✓ Testimonio agregado';
        testimonialForm.reset();
        loadTestimonials();
      } else {
        testimonialStatus.style.color = 'var(--clay)';
        testimonialStatus.textContent = result.message || 'Error al agregar el testimonio';
      }
    } catch {
      testimonialStatus.style.color = 'var(--clay)';
      testimonialStatus.textContent = 'Error al agregar el testimonio';
    } finally {
      testimonialBtn.disabled = false;
    }
  });

  loadTestimonials();
</script>
