---
import Base from '../../layouts/Base.astro';
---

<Base title="Tus Tours">
  <div class="hero" style="min-height: 42vh; background-image: url('https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?auto=format&fit=crop&w=1800&q=80');">
    <div class="hero-content">
      <span class="eyebrow">Tu catálogo</span>
      <h1>Tours por toda Sudamérica</h1>
      <p class="lede">Perú, Bolivia, Chile, Argentina y más — organizados por país para que tus clientes encuentren fácilmente su próxima aventura.</p>
    </div>
  </div>

  <section>
    <div class="explainer-banner">
      <h3>🤖 Agregar un tour es muy simple</h3>
      <p>Solo necesitamos el <strong>nombre del tour</strong>, el o los <strong>países</strong> y el <strong>precio</strong> — un minuto o dos como mucho. Con eso, el sitio investiga automáticamente y sugiere la descripción, duración, distancia, elevación, altitud máxima, dificultad e itinerario típico de ese tour.</p>
      <p>¿El tour cruza de un país a otro? Marca todos los países por los que pasa, y si sabes el punto de inicio/fin o la cantidad de días, agrégalos — eso ayuda mucho a que la ruta e itinerario generados sean precisos. Todo lo demás es opcional.</p>
      <p>Tú solo tienes que revisar lo que se generó y corregir lo que haga falta — mucho más rápido que escribir todo desde cero.</p>
    </div>
  </section>

  <section>
    <h2>Agregar un nuevo tour</h2>
    <form id="tour-form">
      <label for="name">Nombre del tour</label>
      <input type="text" id="name" name="name" required placeholder="Ej: Circuito Ausangate" />

      <label>País(es) — marca todos los que aplique</label>
      <div class="country-checks">
        <label class="check-pill"><input type="checkbox" name="countries" value="Perú" /> 🇵🇪 Perú</label>
        <label class="check-pill"><input type="checkbox" name="countries" value="Bolivia" /> 🇧🇴 Bolivia</label>
        <label class="check-pill"><input type="checkbox" name="countries" value="Chile" /> 🇨🇱 Chile</label>
        <label class="check-pill"><input type="checkbox" name="countries" value="Argentina" /> 🇦🇷 Argentina</label>
        <label class="check-pill"><input type="checkbox" name="countries" value="Ecuador" /> 🇪🇨 Ecuador</label>
        <label class="check-pill"><input type="checkbox" name="countries" value="Colombia" /> 🇨🇴 Colombia</label>
        <label class="check-pill"><input type="checkbox" name="countries" value="Otro" /> 🌎 Otro</label>
      </div>

      <label for="price">Precio por persona (USD)</label>
      <input type="text" id="price" name="price" required placeholder="Ej: 450" />

      <label for="route">Punto de inicio → punto final (opcional, pero muy útil si cruza países)</label>
      <input type="text" id="route" name="route" placeholder="Ej: Cusco → La Paz" />

      <label for="knownDays">¿Cuántos días dura? (opcional — déjalo en blanco si no lo sabes exacto)</label>
      <input type="number" id="knownDays" name="knownDays" min="1" placeholder="Ej: 7" />

      <label for="notes">Notas adicionales (opcional)</label>
      <textarea id="notes" name="notes" placeholder="Cualquier detalle que quieras que tengamos en cuenta — o deja en blanco y lo investigamos por ti."></textarea>

      <label for="photos">Fotos del tour (opcional)</label>
      <div class="file-input">
        <input type="file" id="photos" name="photos" accept="image/*" multiple />
        <span class="file-input-btn">📁 Elegir archivos</span>
        <span class="file-input-name">Ningún archivo seleccionado</span>
      </div>
      <div class="prompt-hint" style="margin-top: 0.4rem;">No hace falta tenerlas ahora — puedes agregar el tour sin fotos y subirlas más adelante, no las necesitamos para armar la página.</div>

      <button type="submit" id="submit-btn">Agregar tour con ayuda de IA</button>
    </form>
    <div id="tour-form-status" style="margin-top: 1rem; font-weight: 600;"></div>
  </section>

  <section>
    <div class="section-head">
      <span class="eyebrow">Catálogo</span>
      <h2>Busca y filtra tus tours</h2>
    </div>
    <p>Incluye los 3 tours de muestra y todos los que agregues con el formulario de arriba — así es como tus clientes van a poder explorar tu catálogo.</p>

    <div class="tour-filters">
      <input type="search" id="tour-search" placeholder="🔍 Buscar por nombre, descripción o ruta..." />
      <div class="filter-row">
        <select id="filter-country"><option value="">Todos los países</option></select>
        <select id="filter-difficulty"><option value="">Cualquier dificultad</option></select>
        <select id="filter-duration">
          <option value="">Cualquier duración</option>
          <option value="short">1–2 días</option>
          <option value="mid">3–5 días</option>
          <option value="long">6+ días</option>
        </select>
        <button type="button" id="filter-clear" class="btn btn-outline">Limpiar filtros</button>
      </div>
    </div>

    <p id="tour-results-count" style="color: var(--stone); font-size: 0.9rem; margin: 1.25rem 0 0.5rem;"></p>
    <div id="tour-catalog">
      <p style="color: var(--stone);">Cargando...</p>
    </div>
  </section>

  <section>
    <div class="card-grid">
      <img src="https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=500&q=80" alt="Cordillera andina" style="width:100%;height:230px;object-fit:cover;border-radius:var(--radius-md);" />
      <img src="https://images.unsplash.com/photo-1509316975850-ff9c5deb0cd9?auto=format&fit=crop&w=500&q=80" alt="Picos entre nubes" style="width:100%;height:230px;object-fit:cover;border-radius:var(--radius-md);" />
      <img src="https://images.unsplash.com/photo-1551632811-561732d1e306?auto=format&fit=crop&w=500&q=80" alt="Excursionista en sendero" style="width:100%;height:230px;object-fit:cover;border-radius:var(--radius-md);" />
    </div>
  </section>

  <section>
    <h2>¿Algo más?</h2>
    <div class="editable-box" data-field="otros" style="border-color: var(--clay);">
      <div class="prompt-q">Cosas importantes sobre tus tours que no te preguntamos</div>
      <div class="prompt-hint">Ej: tours de un día, tours privados vs. grupales, requisitos de reserva, temporada alta/baja, etc.</div>
      <textarea placeholder="Escribe aquí..."></textarea>
      <div class="save-row"><button class="btn-save">Guardar</button><span class="save-status"></span></div>
    </div>
  </section>
</Base>

<script>
  const API = 'https://quechua-aventuras.dstevo191.workers.dev';

  const flagFor = (country: string) => {
    const map: Record<string, string> = {
      'Perú': '🇵🇪', 'Bolivia': '🇧🇴', 'Chile': '🇨🇱', 'Argentina': '🇦🇷',
      'Ecuador': '🇪🇨', 'Colombia': '🇨🇴',
    };
    return map[country] || '🌎';
  };

  function countryPills(countries: string[]): string {
    return (countries || []).map((c) => `<span class="pill">${flagFor(c)} ${c}</span>`).join('');
  }

  interface NormTour {
    slug: string;
    name: string;
    url: string | null;
    countries: string[];
    difficulty: string;
    daysNum: number | null;
    daysDisplay: string;
    distanceKm: string;
    maxAltitudeM: string;
    price: string | null;
    description: string;
    route: string;
    cover: string | null;
    aiGenerated: boolean;
    isExample: boolean;
  }

  const STATIC_TOURS: NormTour[] = [
    {
      slug: 'ausangate-circuit', name: 'Circuito Ausangate', url: '/es/tours/ausangate-circuit/',
      countries: ['Perú'], difficulty: 'Avanzado', daysNum: 5, daysDisplay: '5 días',
      distanceKm: '~60 km', maxAltitudeM: '5,160 m', price: null,
      description: 'Un circuito desafiante de 5 días alrededor de la montaña más sagrada.', route: '',
      cover: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?auto=format&fit=crop&w=500&q=80',
      aiGenerated: false, isExample: true,
    },
    {
      slug: 'siete-lagunas', name: 'Siete Lagunas de Cusco', url: '/es/tours/siete-lagunas/',
      countries: ['Perú'], difficulty: 'Intermedio', daysNum: 3, daysDisplay: '3 días',
      distanceKm: '', maxAltitudeM: '', price: null,
      description: 'Lagunas alpinas espectaculares en un tour de 3 días.', route: '',
      cover: 'https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?auto=format&fit=crop&w=500&q=80',
      aiGenerated: false, isExample: true,
    },
    {
      slug: 'salkantay', name: 'Salkantay Trek', url: '/es/tours/salkantay/',
      countries: ['Perú'], difficulty: 'Intermedio-Avanzado', daysNum: 5, daysDisplay: '5 días',
      distanceKm: '', maxAltitudeM: '', price: null,
      description: 'Ruta alternativa a Machu Picchu cruzando picos nevados.', route: '',
      cover: 'https://images.unsplash.com/photo-1533240332313-0db49b459ad6?auto=format&fit=crop&w=500&q=80',
      aiGenerated: false, isExample: true,
    },
  ];

  function parseDays(str: string | undefined): number | null {
    if (!str) return null;
    const m = str.match(/(\d+)/);
    return m ? parseInt(m[1], 10) : null;
  }

  function normalizeDynamic(tour: any): NormTour {
    return {
      slug: tour.slug,
      name: tour.name,
      url: null,
      countries: tour.countries && tour.countries.length ? tour.countries : ['Otro'],
      difficulty: tour.difficulty || 'Por confirmar',
      daysNum: parseDays(tour.days),
      daysDisplay: tour.days || 'Por confirmar',
      distanceKm: tour.distanceKm || '',
      maxAltitudeM: tour.maxAltitudeM || '',
      price: tour.price || null,
      description: tour.description || '',
      route: tour.route || '',
      cover: tour.photos && tour.photos.length ? tour.photos[0] : null,
      aiGenerated: !!tour.aiGenerated,
      isExample: false,
    };
  }

  let ALL_TOURS: NormTour[] = [...STATIC_TOURS];

  function tourCard(tour: NormTour): string {
    const multi = tour.countries.length > 1;
    const inner = `
        ${tour.cover ? `<div class="card-image-wrap"><img src="${tour.cover}" class="card-image" alt="${tour.name}" /></div>` : ''}
        <div class="card-content">
          <h3 class="card-title">${tour.name}${multi ? ' <span class="pill pill-gold" style="vertical-align:middle;">🌎 multi-país</span>' : ''}${tour.isExample ? ' <span class="pill" style="vertical-align:middle;">Ejemplo</span>' : ''}</h3>
          <p class="card-text">${tour.description.slice(0, 140)}${tour.description.length > 140 ? '…' : ''}</p>
          ${tour.route ? `<p class="card-text" style="font-size:0.85rem;color:var(--stone);">📍 ${tour.route}</p>` : ''}
          <div class="card-meta">
            ${countryPills(tour.countries)}
            <span class="pill pill-clay">${tour.difficulty}</span>
            ${tour.price ? `<span class="pill pill-gold">$${tour.price}</span>` : ''}
            ${tour.aiGenerated ? '<span class="pill pill-ai">✨ detalles sugeridos por IA</span>' : ''}
          </div>
          <div class="card-meta" style="margin-top:0.6rem;">
            <span>${tour.daysDisplay}</span>${tour.distanceKm ? ` · <span>${tour.distanceKm}</span>` : ''}${tour.maxAltitudeM ? ` · <span>Alt. máx ${tour.maxAltitudeM}</span>` : ''}
          </div>
          <div style="margin-top:0.75rem;">
            <a href="/es/panel/#tour-${tour.slug}" class="pill" style="text-decoration:none;" onclick="event.stopPropagation();">✏️ Pedir cambios en este tour</a>
            <div style="font-size:0.72rem;color:var(--stone);margin-top:0.3rem;">(este botón es para ti, Luis)</div>
          </div>
        </div>`;
    return tour.url
      ? `<a href="${tour.url}" class="card" style="text-decoration:none;color:inherit;display:block;">${inner}</a>`
      : `<div class="card">${inner}</div>`;
  }

  function populateFilterOptions() {
    const countrySel = document.getElementById('filter-country') as HTMLSelectElement;
    const diffSel = document.getElementById('filter-difficulty') as HTMLSelectElement;

    const countries = Array.from(new Set(ALL_TOURS.flatMap((t) => t.countries))).sort();
    const currentCountry = countrySel.value;
    countrySel.innerHTML = '<option value="">Todos los países</option>' + countries.map((c) => `<option value="${c}">${flagFor(c)} ${c}</option>`).join('');
    countrySel.value = currentCountry;

    const difficulties = Array.from(new Set(ALL_TOURS.map((t) => t.difficulty))).sort();
    const currentDiff = diffSel.value;
    diffSel.innerHTML = '<option value="">Cualquier dificultad</option>' + difficulties.map((d) => `<option value="${d}">${d}</option>`).join('');
    diffSel.value = currentDiff;
  }

  function matchesFilters(t: NormTour, search: string, country: string, difficulty: string, duration: string): boolean {
    if (search) {
      const hay = `${t.name} ${t.description} ${t.route}`.toLowerCase();
      if (!hay.includes(search)) return false;
    }
    if (country && !t.countries.includes(country)) return false;
    if (difficulty && t.difficulty !== difficulty) return false;
    if (duration) {
      if (t.daysNum == null) return false;
      if (duration === 'short' && t.daysNum > 2) return false;
      if (duration === 'mid' && (t.daysNum < 3 || t.daysNum > 5)) return false;
      if (duration === 'long' && t.daysNum < 6) return false;
    }
    return true;
  }

  function renderCatalog() {
    const container = document.getElementById('tour-catalog')!;
    const countEl = document.getElementById('tour-results-count')!;
    const search = (document.getElementById('tour-search') as HTMLInputElement).value.trim().toLowerCase();
    const country = (document.getElementById('filter-country') as HTMLSelectElement).value;
    const difficulty = (document.getElementById('filter-difficulty') as HTMLSelectElement).value;
    const duration = (document.getElementById('filter-duration') as HTMLSelectElement).value;

    const filtered = ALL_TOURS.filter((t) => matchesFilters(t, search, country, difficulty, duration));

    if (!filtered.length) {
      countEl.textContent = '0 tours encontrados';
      container.innerHTML = '<p style="color: var(--stone);">Ningún tour coincide con esos filtros. Prueba con otra búsqueda o toca "Limpiar filtros".</p>';
      return;
    }

    countEl.textContent = `${filtered.length} tour${filtered.length === 1 ? '' : 's'} encontrado${filtered.length === 1 ? '' : 's'}`;

    // Group by country; a multi-country tour appears under every country it touches
    const byCountry: Record<string, NormTour[]> = {};
    for (const tour of filtered) {
      for (const c of tour.countries) {
        byCountry[c] = byCountry[c] || [];
        byCountry[c].push(tour);
      }
    }

    let html = '';
    for (const c of Object.keys(byCountry).sort()) {
      html += `<div class="country-heading"><span class="country-flag">${flagFor(c)}</span><h3 style="margin:0;">${c}</h3></div>`;
      html += `<div class="card-grid">${byCountry[c].map(tourCard).join('')}</div>`;
    }
    container.innerHTML = html;
  }

  async function loadTours() {
    try {
      const res = await fetch(`${API}/api/tours`);
      const result = await res.json();
      const dynamic = result.success ? result.tours.map(normalizeDynamic) : [];
      ALL_TOURS = [...STATIC_TOURS, ...dynamic];
    } catch (e) {
      ALL_TOURS = [...STATIC_TOURS];
    }
    populateFilterOptions();
    renderCatalog();
  }

  document.getElementById('tour-search')!.addEventListener('input', renderCatalog);
  document.getElementById('filter-country')!.addEventListener('change', renderCatalog);
  document.getElementById('filter-difficulty')!.addEventListener('change', renderCatalog);
  document.getElementById('filter-duration')!.addEventListener('change', renderCatalog);
  document.getElementById('filter-clear')!.addEventListener('click', () => {
    (document.getElementById('tour-search') as HTMLInputElement).value = '';
    (document.getElementById('filter-country') as HTMLSelectElement).value = '';
    (document.getElementById('filter-difficulty') as HTMLSelectElement).value = '';
    (document.getElementById('filter-duration') as HTMLSelectElement).value = '';
    renderCatalog();
  });

  const form = document.getElementById('tour-form') as HTMLFormElement;
  const statusEl = document.getElementById('tour-form-status')!;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const photosInput = document.getElementById('photos') as HTMLInputElement;
  const photosFileName = form.querySelector('.file-input-name') as HTMLElement;

  photosInput.addEventListener('change', () => {
    const n = photosInput.files?.length || 0;
    photosFileName.textContent = n === 0 ? 'Ningún archivo seleccionado' : n === 1 ? photosInput.files![0].name : `${n} archivos seleccionados`;
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const anyCountryChecked = form.querySelectorAll('input[name="countries"]:checked').length > 0;
    if (!anyCountryChecked) {
      statusEl.style.color = 'var(--clay)';
      statusEl.textContent = 'Marca al menos un país.';
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Investigando y generando detalles... (puede tardar unos segundos)';
    statusEl.textContent = '';

    try {
      const formData = new FormData(form);
      const res = await fetch(`${API}/api/submit-tour`, { method: 'POST', body: formData });
      const result = await res.json();

      if (result.success) {
        statusEl.style.color = 'var(--forest)';
        statusEl.innerHTML = `✓ "${result.tour.name}" agregado con éxito. Revisa el catálogo en vivo abajo y corrige cualquier detalle que no sea exacto.`;
        form.reset();
        photosFileName.textContent = 'Ningún archivo seleccionado';
        loadTours();
      } else {
        statusEl.style.color = 'var(--clay)';
        statusEl.textContent = result.message || 'Error al agregar el tour';
      }
    } catch (err) {
      statusEl.style.color = 'var(--clay)';
      statusEl.textContent = 'Error al agregar el tour. Intenta de nuevo.';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Agregar tour con ayuda de IA';
    }
  });

  loadTours();

  // ---- Editable "¿Algo más?" box ----
  const PAGE = 'tours';
  async function loadContent() {
    try {
      const res = await fetch(`${API}/api/get-content?page=${PAGE}`);
      const result = await res.json();
      if (result.success) {
        document.querySelectorAll('.editable-box').forEach((box) => {
          const field = box.getAttribute('data-field');
          const textarea = box.querySelector('textarea') as HTMLTextAreaElement;
          if (field && result.data[field]) textarea.value = result.data[field];
        });
      }
    } catch (e) {
      console.error(e);
    }
  }

  document.querySelectorAll('.editable-box').forEach((box) => {
    const field = box.getAttribute('data-field');
    const textarea = box.querySelector('textarea') as HTMLTextAreaElement;
    const btn = box.querySelector('.btn-save') as HTMLButtonElement;
    const status = box.querySelector('.save-status') as HTMLElement;
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      status.textContent = 'Guardando...';
      try {
        const res = await fetch(`${API}/api/save-content`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ page: PAGE, field, value: textarea.value }),
        });
        const result = await res.json();
        status.textContent = result.success ? '✓ Guardado' : 'Error al guardar';
        setTimeout(() => (status.textContent = ''), 3000);
      } catch {
        status.textContent = 'Error al guardar';
      } finally {
        btn.disabled = false;
      }
    });
  });

  loadContent();
</script>
