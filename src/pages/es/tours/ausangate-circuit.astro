---
import Base from '../../../layouts/Base.astro';
---

<Base title="Circuito Ausangate">
  <div class="tour-hero" style="background-image: url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?auto=format&fit=crop&w=1800&q=80');">
    <div class="tour-hero-content">
      <span class="pill pill-gold">🇵🇪 Perú</span>
      <h1>Circuito Ausangate</h1>
      <p style="color: rgba(255,255,255,0.9); max-width: 560px;">5 días alrededor de la montaña más sagrada de la región del Cusco.</p>
    </div>
  </div>

  <section>
    <div class="stat-grid">
      <div class="stat-block"><div class="stat-label">Duración</div><div class="stat-value">5 días</div></div>
      <div class="stat-block"><div class="stat-label">Distancia</div><div class="stat-value">~60 km</div></div>
      <div class="stat-block"><div class="stat-label">Altitud máx.</div><div class="stat-value">5,160 m</div></div>
      <div class="stat-block"><div class="stat-label">Dificultad</div><div class="stat-value">Avanzado</div></div>
      <div class="stat-block"><div class="stat-label">Mejor época</div><div class="stat-value">May–Sep</div></div>
    </div>

    <h2>Descripción</h2>
    <p><strong>📝 [PENDIENTE]</strong> Descripción detallada del circuito — qué lo hace especial, qué se ve (glaciares, fauna, comunidades), y la importancia cultural de Ausangate.</p>

    <h2>Itinerario</h2>
    <div class="panel">
      <div class="itinerary-day">
        <div class="itinerary-day-num">1</div>
        <div><h4>Cusco → punto de partida</h4><p class="mb-0"><strong>📝 [PENDIENTE]</strong> Altitud, distancia, campamento del día 1.</p></div>
      </div>
      <div class="itinerary-day">
        <div class="itinerary-day-num">2</div>
        <div><h4>Paso de altura</h4><p class="mb-0"><strong>📝 [PENDIENTE]</strong></p></div>
      </div>
      <div class="itinerary-day">
        <div class="itinerary-day-num">3</div>
        <div><h4>Lagunas glaciares</h4><p class="mb-0"><strong>📝 [PENDIENTE]</strong></p></div>
      </div>
      <div class="itinerary-day">
        <div class="itinerary-day-num">4</div>
        <div><h4>Comunidades altoandinas</h4><p class="mb-0"><strong>📝 [PENDIENTE]</strong></p></div>
      </div>
      <div class="itinerary-day">
        <div class="itinerary-day-num">5</div>
        <div><h4>Regreso a Cusco</h4><p class="mb-0"><strong>📝 [PENDIENTE]</strong></p></div>
      </div>
    </div>

    <h2>Incluye / No incluye</h2>
    <div class="card-grid">
      <div class="card"><div class="card-content">
        <h3 class="card-title">✓ Incluido</h3>
        <ul style="margin-left: 1rem;">
          <li><strong>📝</strong> Transporte desde Cusco</li>
          <li><strong>📝</strong> Campamento y equipo</li>
          <li><strong>📝</strong> Todas las comidas</li>
          <li><strong>📝</strong> Guía experto</li>
        </ul>
      </div></div>
      <div class="card"><div class="card-content">
        <h3 class="card-title">✗ No incluido</h3>
        <ul style="margin-left: 1rem;">
          <li><strong>📝</strong> Vuelos a Cusco</li>
          <li><strong>📝</strong> Alojamiento previo/posterior</li>
          <li><strong>📝</strong> Seguro de viaje</li>
          <li><strong>📝</strong> Propinas</li>
        </ul>
      </div></div>
    </div>

    <h2>Galería</h2>
    <div class="card-grid">
      <img src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?auto=format&fit=crop&w=500&q=80" alt="Montaña" style="width:100%;height:230px;object-fit:cover;border-radius:var(--radius-md);" />
      <img src="https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?auto=format&fit=crop&w=500&q=80" alt="Laguna" style="width:100%;height:230px;object-fit:cover;border-radius:var(--radius-md);" />
      <img src="https://images.unsplash.com/photo-1533240332313-0db49b459ad6?auto=format&fit=crop&w=500&q=80" alt="Cumbre" style="width:100%;height:230px;object-fit:cover;border-radius:var(--radius-md);" />
    </div>
    <p style="text-align:center;color:var(--stone);font-size:0.9rem;">📸 Estas fotos genéricas se reemplazarán por tus fotos reales de la expedición.</p>

    <div class="panel panel-cream text-center" style="margin-top: 2rem;">
      <h3>¿Interesado en este tour?</h3>
      <a href="/es/contacto/" class="btn btn-primary">Contactar a Luis</a>
      <a href="/es/panel/#tour-ausangate-circuit" class="btn btn-outline" style="margin-left:0.75rem;">✏️ Pedir cambios en este tour</a>
    </div>
  </section>
</Base>
