---
import Base from '../../../layouts/Base.astro';
---

<Base title="Salkantay Trek">
  <div class="tour-hero" style="background-image: url('https://images.unsplash.com/photo-1587595431973-160beaf930f1?auto=format&fit=crop&w=1800&q=80');">
    <div class="tour-hero-content">
      <span class="pill pill-gold">🇵🇪 Perú</span>
      <h1>Salkantay Trek</h1>
      <p style="color: rgba(255,255,255,0.9); max-width: 560px;">La ruta alternativa a Machu Picchu, cruzando picos nevados hasta la ciudadela inca.</p>
    </div>
  </div>

  <section>
    <div class="stat-grid">
      <div class="stat-block"><div class="stat-label">Duración</div><div class="stat-value">5 días</div></div>
      <div class="stat-block"><div class="stat-label">Distancia</div><div class="stat-value">~50 km</div></div>
      <div class="stat-block"><div class="stat-label">Altitud máx.</div><div class="stat-value">4,650 m</div></div>
      <div class="stat-block"><div class="stat-label">Dificultad</div><div class="stat-value">Interm.-Avanz.</div></div>
      <div class="stat-block"><div class="stat-label">Mejor época</div><div class="stat-value">Abr–Oct</div></div>
    </div>

    <h2>Descripción</h2>
    <p><strong>📝 [PENDIENTE]</strong> El Salkantay Trek combina alta montaña, selva y arqueología, culminando en Machu Picchu.</p>

    <h2>Itinerario</h2>
    <div class="panel">
      <div class="itinerary-day"><div class="itinerary-day-num">1</div><div><h4>Cusco → Mollepata</h4><p class="mb-0"><strong>📝 [PENDIENTE]</strong></p></div></div>
      <div class="itinerary-day"><div class="itinerary-day-num">2</div><div><h4>Ascenso al paso Salkantay</h4><p class="mb-0"><strong>📝 [PENDIENTE]</strong></p></div></div>
      <div class="itinerary-day"><div class="itinerary-day-num">3</div><div><h4>Descenso al valle</h4><p class="mb-0"><strong>📝 [PENDIENTE]</strong></p></div></div>
      <div class="itinerary-day"><div class="itinerary-day-num">4</div><div><h4>Hacia Aguas Calientes</h4><p class="mb-0"><strong>📝 [PENDIENTE]</strong></p></div></div>
      <div class="itinerary-day"><div class="itinerary-day-num">5</div><div><h4>Machu Picchu</h4><p class="mb-0"><strong>📝 [PENDIENTE]</strong></p></div></div>
    </div>

    <div class="panel panel-cream text-center" style="margin-top: 2rem;">
      <h3>¿Interesado en este tour?</h3>
      <a href="/es/contacto/" class="btn btn-primary">Contactar a Luis</a>
    </div>
  </section>
</Base>
